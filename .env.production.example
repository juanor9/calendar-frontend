# Auth0 Configuration - PRODUCTION
# Replace these with your actual Auth0 production application values

VITE_AUTH0_DOMAIN=dev-vana-calendar.us.auth0.com
VITE_AUTH0_CLIENT_ID=YOUR_PRODUCTION_SPA_CLIENT_ID
VITE_AUTH0_AUDIENCE=https://api.vana-calendar.com

# App URLs - Production
VITE_APP_URL=https://vana-app.vercel.app
VITE_API_URL=https://your-backend-domain.com

# GraphQL Endpoint - Production
VITE_GRAPHQL_ENDPOINT=https://your-backend-domain.com/graphql

# Environment
NODE_ENV=production

# IMPORTANT: 
# 1. Get your production Client ID from Auth0 Dashboard > Applications > Vana Calendar SPA
# 2. Set these as environment variables in your deployment platform (Vercel/Netlify)
# 3. Never commit actual production values to the repository