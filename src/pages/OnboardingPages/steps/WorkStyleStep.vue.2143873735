    text-align: center;
    margin-bottom: 3rem;

    .step-title {
      font-size: 2rem;
      font-weight: 700;
      color: #1a202c;
      margin-bottom: 0.75rem;

      @media (width <= 640px) {
        font-size: 1.75rem;
      }
    }

    .step-subtitle {
      font-size: 1.125rem;
      color: #718096;
      line-height: 1.6;
    }
  }

  .section {
    margin-bottom: 3rem;

    .section-title {
      font-size: 1.25rem;
      font-weight: 600;
      color: #2d3748;
      margin-bottom: 1.5rem;
    }
  }

  /* Work Style Selection */

  .work-style-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
  }

  .work-style-card {
    padding: 1.5rem;
    border: 2px solid #e2e8f0;
    border-radius: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    background: white;

    &:hover:not(.disabled) {
      border-color: #667eea;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(102, 126, 234, 15%);
    }

    &.selected {
      border-color: #667eea;
      background: linear-gradient(135deg, rgba(102, 126, 234, 5%), rgba(118, 75, 162, 5%));

      .style-icon {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
      }
    }

    &.disabled {
      opacity: 60%;
      cursor: not-allowed;
    }

    .style-icon {
      width: 56px;
      height: 56px;
      border-radius: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f7fafc;
      color: #4a5568;
      margin-bottom: 1rem;
      transition: all 0.3s ease;
    }

    .style-title {
      font-size: 1.125rem;
      font-weight: 600;
      color: #1a202c;
      margin-bottom: 0.5rem;
    }

    .style-description {
      color: #718096;
      margin-bottom: 1rem;
      line-height: 1.5;
    }

    .style-features {
      list-style: none;
      padding: 0;
      margin: 0;

      li {
        color: #4a5568;
        font-size: 0.875rem;
        margin-bottom: 0.25rem;
        position: relative;
        padding-left: 1rem;

        &::before {
          content: '•';
          color: #667eea;
          position: absolute;
          left: 0;
        }
      }
    }
  }

  /* Work Hours Configuration */

  .work-hours-config {
    background: #f7fafc;
    border-radius: 1rem;
    padding: 1.5rem;
    margin-bottom: 1rem;
  }

  .time-inputs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .time-input-group {

    .input-label {
      display: block;
      font-weight: 500;
      color: #2d3748;
      margin-bottom: 0.5rem;
    }

    .time-select {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid #e2e8f0;
      border-radius: 0.5rem;
      background: white;
      color: #2d3748;
      font-size: 0.875rem;

      &:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 10%);
      }

      &:disabled {
        background: #f7fafc;
        cursor: not-allowed;
      }
    }
  }

  .work-days {

    .input-label {
      display: block;
      font-weight: 500;
      color: #2d3748;
      margin-bottom: 0.75rem;
    }

    .days-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 0.5rem;
    }

    .day-button {
      padding: 0.75rem 0.5rem;
      border: 1px solid #e2e8f0;
      border-radius: 0.5rem;
      background: white;
      color: #4a5568;
      font-size: 0.875rem;
      cursor: pointer;
      transition: all 0.2s ease;

      &:hover:not(:disabled) {
        border-color: #667eea;
      }

      &.selected {
        background: #667eea;
        border-color: #667eea;
        color: white;
      }

      &:disabled {
        opacity: 50%;
        cursor: not-allowed;
      }
    }
  }

  .work-hours-summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #4a5568;
    font-size: 0.875rem;
    background: white;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid #e2e8f0;
  }

  /* Meeting Preferences */

  .preferences-grid {
    display: grid;
    gap: 1rem;
  }

  .preference-item {

    .preference-label {
      display: block;
      font-weight: 500;
      color: #2d3748;

      .preference-select {
        display: block;
        width: 100%;
        margin-top: 0.5rem;
        padding: 0.75rem;
        border: 1px solid #e2e8f0;
        border-radius: 0.5rem;
        background: white;
        color: #2d3748;

        &:focus {
          outline: none;
          border-color: #667eea;
          box-shadow: 0 0 0 3px rgba(102, 126, 234, 10%);
        }

        &:disabled {
          background: #f7fafc;
          cursor: not-allowed;
        }
      }
    }

    .preference-checkbox {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      cursor: pointer;

      input[type='checkbox'] {
        width: 18px;
        height: 18px;
        margin-top: 0.125rem;
        accent-color: #667eea;

        &:disabled {
          cursor: not-allowed;
        }
      }

      .checkbox-label {
        color: #2d3748;
        line-height: 1.5;
      }
    }
  }

  /* Responsive Design */
  @media (width <= 640px) {

    .step-content {
      padding: 1rem;
    }

    .work-style-grid {
      grid-template-columns: 1fr;
    }

    .time-inputs {
      grid-template-columns: 1fr;
    }

    .days-grid {
      grid-template-columns: repeat(4, 1fr);

      .day-button {
        padding: 0.5rem 0.25rem;
