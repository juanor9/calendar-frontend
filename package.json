{
  "name": "vana-planner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc -p tsconfig.build.json",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "test:auth": "tsx scripts/run-auth-tests.ts",
    "test:auth:unit": "vitest run tests/unit/auth --coverage",
    "test:auth:components": "vitest run tests/unit/components/auth --coverage",
    "test:auth:performance": "vitest run tests/performance/auth-performance.spec.ts",
    "test:auth:a11y": "vitest run tests/a11y/auth-accessibility.spec.ts",
    "test:auth:e2e": "cypress run --spec 'tests/e2e/auth/**/*.cy.ts'",
    "test:auth:watch": "vitest watch tests/unit/auth tests/unit/components/auth",
    "test:auth:ci": "tsx scripts/run-auth-tests.ts --skip-optional --report",
    "test:patterns": "tsx tests/scripts/validate-error-patterns.ts validate",
    "test:patterns:list": "tsx tests/scripts/list-patterns.ts list",
    "test:patterns:critical": "tsx tests/scripts/validate-error-patterns.ts critical",
    "test:token-handling": "vitest run tests/unit/auth/auth0-token-handling.spec.ts --coverage",
    "test:event-types": "vitest run tests/unit/components/event-handler-types.spec.ts --coverage",
    "test:asset-loading": "vitest run tests/unit/assets/asset-loading.spec.ts --coverage",
    "test:web-vitals": "vitest run tests/performance/web-vitals-integration.spec.ts --coverage",
    "test:typescript-generics": "vitest run tests/unit/types/typescript-generics.spec.ts --coverage",
    "test:storybook-validation": "vitest run tests/unit/storybook/stories-validation.spec.ts --coverage",
    "test:registration": "tsx tests/scripts/run-registration-tests.ts",
    "test:registration:unit": "vitest run tests/unit/composables tests/unit/components tests/unit/pages --coverage",
    "test:registration:integration": "vitest run tests/integration --coverage",
    "test:registration:e2e": "cypress run --spec 'tests/e2e/registration/**/*.cy.ts'",
    "test:registration:a11y": "vitest run tests/a11y --coverage",
    "test:registration:performance": "vitest run tests/performance --coverage",
    "test:registration:watch": "vitest watch tests/unit/composables tests/unit/components tests/unit/pages",
    "test:registration:ci": "tsx tests/scripts/run-registration-tests.ts --skip-optional --report --no-parallel",
    "test:registration:quick": "tsx tests/scripts/run-registration-tests.ts --skip-optional --no-coverage",
    "test:registration:full": "tsx tests/scripts/run-registration-tests.ts --report --verbose",
    "storybook": "cross-env STORYBOOK=1 storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint src --ext .ts,.vue",
    "lint:style": "stylelint \"src/**/*.{scss,vue}\"",
    "lint:all": "npm-run-all2 lint lint:style",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node -e \"console.log('manual husky setup — skipping prepare')\""
  },
  "dependencies": {
    "@apollo/client": "^3.13.9",
    "@apollo/client-react-streaming": "^0.12.3",
    "@auth0/auth0-spa-js": "^2.3.0",
    "@auth0/auth0-vue": "^2.4.0",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-codegen/typescript-vue-apollo": "^4.1.2",
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@vue/apollo-composable": "^4.2.2",
    "@vueuse/core": "^13.6.0",
    "@vueuse/head": "^2.0.0",
    "@vueuse/integrations": "^13.6.0",
    "graphql": "^16.11.0",
    "pinia": "^3.0.3",
    "socket.io-client": "^4.8.1",
    "vitest-axe": "^0.1.0",
    "vue": "^3.5.17",
    "vue-draggable-plus": "^0.6.0",
    "vue-router": "^4.5.1",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.0.1",
    "@pinia/testing": "^1.0.2",
    "@storybook/addon-a11y": "^9.0.16",
    "@storybook/addon-docs": "^9.0.16",
    "@storybook/addon-links": "^9.0.16",
    "@storybook/addon-onboarding": "^9.0.16",
    "@storybook/addon-vitest": "^9.0.16",
    "@storybook/vue3-vite": "^9.0.16",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.32",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "axe-core": "^4.10.3",
    "chalk": "^5.5.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-vue": "^9.33.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "npm-run-all2": "^8.0.4",
    "playwright": "^1.53.2",
    "postcss-html": "^1.8.0",
    "sass-embedded": "^1.89.2",
    "storybook": "^9.0.16",
    "stylelint": "^16.21.1",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-scss": "^6.12.1",
    "tsx": "^4.20.3",
    "typescript": "~5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-vue-devtools": "^7.7.7",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^2.2.10"
  },
  "overrides": {
    "@rollup/rollup": "4.16.3"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix"
    ],
    "*.{scss,vue}": [
      "stylelint --fix"
    ],
    "*.{ts,vue,scss,md,json}": [
      "prettier --write"
    ]
  }
}
